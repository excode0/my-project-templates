# Database
DATABASE_URL=postgres://user:password@localhost:5432/template_marketplace

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Platform Settings
PLATFORM_FEE_PERCENTAGE=30
DEFAULT_DOMAIN_SUFFIX=.myplatform.com

# Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./public/uploads

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379

# Payment mode: mock (dev, provisions instantly) | midtrans (real Snap checkout)
PAYMENT_MODE=mock

# Payment Gateway (Midtrans)
MIDTRANS_SERVER_KEY=your-server-key-here
MIDTRANS_CLIENT_KEY=your-client-key-here
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-client-key-here
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
# For production: https://app.midtrans.com/snap/snap.js

# Email (SMTP)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=TemplateMKT
SMTP_FROM_EMAIL=noreply@templatemkt.com
